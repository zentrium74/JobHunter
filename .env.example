# ─── LLM Providers (all optional — Ollama runs keyless) ───────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# ─── Default LLM backend ──────────────────────────────────────────────────────
# Options: ollama | openai | anthropic | groq | gemini
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2

# ─── Ollama ───────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434

# ─── Crawl4AI ─────────────────────────────────────────────────────────────────
CRAWL4AI_HEADLESS=true
CRAWL4AI_BROWSER_TYPE=chromium

# ─── Chandra OCR ──────────────────────────────────────────────────────────────
CHANDRA_API_KEY=
CHANDRA_API_URL=https://api.datalab.to/api/v1
# Set USE_LOCAL_OCR=true to use local fallback (pdfplumber + pytesseract)
USE_LOCAL_OCR=false

# ─── Backend ──────────────────────────────────────────────────────────────────
BACKEND_PORT=8000
BACKEND_HOST=localhost
API_TOKEN=jobhunter-dev-token

# ─── Storage (local paths) ────────────────────────────────────────────────────
DATA_DIR=./data
SQLITE_PATH=./data/jobhunter.db
KUZU_PATH=./data/kuzu_graph
LANCEDB_PATH=./data/lancedb
GENERATED_DOCS_DIR=./data/generated

# ─── RAGAS Evaluation ─────────────────────────────────────────────────────────
RAGAS_ENABLED=true
RAGAS_LLM_PROVIDER=ollama
