# ─── LLM Providers (all optional — Ollama runs keyless) ───────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# ─── Default LLM backend ──────────────────────────────────────────────────────
# Options: ollama | openai | anthropic | groq | gemini
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2

# ─── Ollama ───────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434

# ─── Crawl4AI ─────────────────────────────────────────────────────────────────
CRAWL4AI_HEADLESS=true
CRAWL4AI_BROWSER_TYPE=chromium

# ─── Chandra OCR ──────────────────────────────────────────────────────────────
CHANDRA_API_KEY=
CHANDRA_API_URL=https://api.datalab.to/api/v1
# Set USE_LOCAL_OCR=true to use local fallback (pdfplumber + pytesseract)
USE_LOCAL_OCR=false

# ─── Backend ──────────────────────────────────────────────────────────────────
BACKEND_PORT=8000
BACKEND_HOST=localhost
API_TOKEN=jobhunter-dev-token

# ─── Storage (local paths) ────────────────────────────────────────────────────
DATA_DIR=./data
SQLITE_PATH=./data/jobhunter.db
LANCEDB_PATH=./data/lancedb
GENERATED_DOCS_DIR=./data/generated

# ─── mem0 Profile Memory (replaces Kuzu — Kuzu archived Oct 2025) ─────────────
MEM0_GRAPH_PATH=./data/mem0_graph
MEM0_EMBED_MODEL=nomic-embed-text
# Neo4j connection for mem0 graph store (local Docker or AuraDB free tier)
NEO4J_URL=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=jobhunter

# ─── LiteLLM Token Cost Efficiency ────────────────────────────────────────────
# Per-task token budgets (tune to balance quality vs cost)
LITELLM_MAX_TOKENS_RANK=512
LITELLM_MAX_TOKENS_GEN=1024
LITELLM_MAX_TOKENS_EVAL=256
# Optional: Langfuse cost tracking (leave blank to disable)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ─── DeepEval Evaluation (replaces RAGAS) ─────────────────────────────────────
DEEPEVAL_THRESHOLD=0.7
DEEPEVAL_VERBOSE=false
